{
  "name": "screen-share-electron",
  "version": "0.1.9",
  "author": {
  "name": "Gabriel Miranda",
  "email": "gabriel.miranda041200@gmail.com"
  },
  "description": "Compartilhamento de tela via WebRTC",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder build --win",
    "release": "electron-builder build --win --publish always",
    "release:linux": "electron-builder build --linux rpm --publish always"
  },
  "build": {
    "appId": "com.sharesync.app",
    "productName": "ShareSync",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": ["rpm"],
      "category": "Network",
      "synopsis": "Compartilhamento de tela via WebRTC",
      "icon": "src/assets/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "Gabrie2121",
      "repo": "screenSharerClient"
    }
  },
  "devDependencies": {
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0"
  },
  "dependencies": {
    "electron-updater": "^6.8.9"
  }
}
