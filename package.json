{
  "name": "screen-share-electron",
  "version": "0.4.0",
  "author": {
    "name": "Gabriel Miranda",
    "email": "gabriel.miranda041200@gmail.com"
  },
  "description": "Compartilhamento de tela via WebRTC",
  "main": "src/main.js",
  "scripts": {
    "start": "electron .",
    "check": "node scripts/check.js",
    "build": "npm run build:native && electron-builder build --win",
    "release": "npm run build:native && electron-builder build --win --publish always",
    "release:dev": "electron-builder build --win --publish always --config.publish.releaseType=prerelease && node scripts/publish-dev-bridge.js",
    "release:linux": "electron-builder build --linux rpm --publish always",
    "version:dev": "npm version prerelease --preid=dev --no-git-tag-version",
    "build:native": "node scripts/build-native.js"
  },
  "build": {
    "appId": "com.sharesync.app",
    "productName": "ShareSync",
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": "nsis",
      "icon": "src/assets/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true
    },
    "linux": {
      "target": [
        "rpm"
      ],
      "category": "Network",
      "synopsis": "Compartilhamento de tela via WebRTC",
      "icon": "src/assets/icon.png"
    },
    "publish": {
      "provider": "github",
      "owner": "Gabrie2121",
      "repo": "screenSharerClient"
    },
    "files": [
      "**/*",
      "!native/process-audio/build/**/*",
      "!native/process-audio/src/**/*",
      "native/process-audio/build/Release/process_audio.node"
    ],
    "asarUnpack": [
      "native/process-audio/build/Release/*.node"
    ]
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.0",
    "electron": "^30.0.0",
    "electron-builder": "^24.0.0",
    "node-addon-api": "^8.9.2"
  },
  "dependencies": {
    "@sapphi-red/web-noise-suppressor": "^0.4.0",
    "electron-updater": "^6.8.9"
  }
}
